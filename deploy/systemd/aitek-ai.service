[Unit]
Description=AITEK AI testcase service
After=network.target mysql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/aitek/ai-testcase-service
EnvironmentFile=-/opt/aitek/ai-testcase-service/.env
# 用例生成是长 SSE：超时按整段请求计时。过短会被杀掉，Django 会看到 illegal chunk header / HTTP 500
ExecStart=/opt/aitek/ai-testcase-service/venv/bin/gunicorn -b 127.0.0.1:8002 -t 3600 --graceful-timeout 30 --workers 2 --keep-alive 2 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
